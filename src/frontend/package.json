{
    "name": "coldfront",
    "version": "2.0.0",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run --parallel dev:js dev:css",
        "dev:js": "bun build ./src/coldfront.ts --outdir ../coldfront/static/bundles --watch",
        "dev:css": "bun tailwindcss -i ./src/styles/coldfront.css -o ../coldfront/static/bundles/coldfront.css --watch=always",
        "build": "bun run build:js && bun run build:css",
        "build:js": "bun build ./src/coldfront.ts --outdir ../coldfront/static/bundles --minify",
        "build:css": "bun tailwindcss -i ./src/styles/coldfront.css -o ../coldfront/static/bundles/coldfront.css --minify",
        "lint": "bun biome lint ./src",
        "format": "bun biome format --write ./src",
        "format:check": "bun biome format ./src",
        "check": "bun run lint && bun run format:check"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tailwindcss/cli": "^4.3.3",
        "@types/alpinejs": "^3.17.0",
        "@types/bun": "^1.4.3",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.17.4",
        "@alpinejs/focus": "^3.17.4",
        "alpinejs": "^3.17.4",
        "chart.js": "^4.5.1",
        "daisyui": "^5.7.50",
        "htmx.org": "^2.0.11",
        "tailwindcss": "^4.3.3",
        "vanilla-calendar-pro": "^3.4.0"
    }
}
